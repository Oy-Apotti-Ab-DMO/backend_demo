# Copy to .env and fill in. Loaded with: node --env-file=.env
PROFILE=epic                 # epic | apotti
CLIENT_ID=                   # Non-Production Client ID from fhir.epic.com
KID=demo-key-1               # must match the "kid" in your published JWK Set
PRIVATE_KEY_PATH=keys/private.pem
# Optional: include a jku header pointing at your registered JWK Set URL
JKU=
# Optional: override scope (Epic backend apps normally omit scope; the app's registered APIs apply)
SCOPE=
# Optional: override FHIR base (use .../api/FHIR/STU3 if the app is registered only for STU3 APIs)
FHIR_BASE=
